# Leave unset before launch and the organizer login accepts "playvejora-dev".
# This fallback is refused in production builds, so set a real value to deploy.
ADMIN_PASSWORD=

# Public site origin used for canonical URLs, Open Graph, and the sitemap.
# Defaults to the production domain; override for staging or a preview host.
SITE_URL=https://playvejora.dpdns.org
