# Used by `npm run dev` only. The Worker reads ADMIN_PASSWORD from .dev.vars
# locally and from a Cloudflare secret in production.

# Leave unset and the dev-only login accepts "playvejora-dev".
ADMIN_PASSWORD=

# Public site origin used for canonical URLs, Open Graph, and the sitemap.
# Defaults to the production domain; override for a staging origin.
SITE_URL=https://playvejora.dpdns.org

# Optional. When set, a completed registration emails the organizers via Resend.
# Leave unset and signup still works; nobody is emailed.
RESEND_API_KEY=
# MAIL_FROM=PlayVejora <beth.t@example.com>
# ORGANIZER_EMAIL=playvejora@gmail.com
